APP_NAME=BoardMate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila
FRONTEND_URL=http://localhost:8100
CORS_ALLOWED_ORIGINS=http://localhost:8100,http://localhost:5173,capacitor://localhost,http://localhost

# The only seeded account (php artisan db:seed). Everyone else signs up in the app.
ADMIN_NAME="BoardMate Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=
PRIVACY_POLICY_VERSION=2026-10-03

# Logins expire after this many days without using the app.
SANCTUM_IDLE_DAYS=30

# "Continue with Google": Web OAuth client ID (Google Cloud Console). Not a secret.
GOOGLE_CLIENT_ID=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=boardmate
DB_USERNAME=postgres
DB_PASSWORD=null


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log
# MAIL_SCHEME=null
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS="hello@example.com"
# MAIL_FROM_NAME="${APP_NAME}"

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_SCHEME=null
MAIL_PORT=587
MAIL_USERNAME=...@gmail.com
MAIL_PASSWORD="..."
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=...@gmail.com
MAIL_FROM_NAME="BoardMate"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
